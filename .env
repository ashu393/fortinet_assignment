# ---------- API ----------
APP_ENV=local
JWT_SECRET=supersecret-change-me
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRES_MIN=120

# ---------- DATABASE ----------
DATABASE_URL=sqlite:///./data/app.db

# ---------- VECTOR DB (Qdrant) ----------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=contracts_chunks

# ---------- LLM (Ollama) ----------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ---------- EMBEDDINGS ----------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_TEXT_MAX_CHARS=1200
EMBED_MODEL=mxbai-embed-large
CHUNK_SIZE=900
CHUNK_OVERLAP=150
QDRANT_COLLECTION=contracts_chunks

# ---------- GUARDRAILS DEFAULTS ----------
DEFAULT_HALLUCINATION_THRESHOLD=0.70
DEFAULT_REQUIRE_CITATIONS=true
DEFAULT_PII_REDACTION=true
